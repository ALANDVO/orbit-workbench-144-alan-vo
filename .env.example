# Orbit Workbench Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=orbit-workbench-144-alan-vo
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/orbit.db

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OIDC / Keycloak
OIDC_ISSUER_URL=http://localhost:8080/realms/orbit-workbench
OIDC_CLIENT_ID=orbit-workbench-frontend
OIDC_CLIENT_SECRET=orbit-workbench-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/callback
OIDC_SCOPES=openid profile email roles

# LLM
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin